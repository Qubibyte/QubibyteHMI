# Allow Qubibyte HMI Diagnostics to control the Pi onboard activity LED (ACT / led0).
# Install: bash scripts/install-qubibyte-pi.sh  (or scripts/setup-pi-led-permissions.sh)
# Requires: user in group "led" and log out/in once after first install.

SUBSYSTEM=="leds", KERNEL=="ACT", GROUP="led", MODE="0666"
SUBSYSTEM=="leds", KERNEL=="led0", GROUP="led", MODE="0666"
SUBSYSTEM=="leds", KERNEL=="ACT", ACTION=="add|change", RUN+="/bin/chmod 666 /sys/class/leds/ACT/brightness /sys/class/leds/ACT/trigger"
SUBSYSTEM=="leds", KERNEL=="led0", ACTION=="add|change", RUN+="/bin/chmod 666 /sys/class/leds/led0/brightness /sys/class/leds/led0/trigger"
